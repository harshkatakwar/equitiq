# ===========================================
# ResearchOS Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# Application
APP_NAME=ResearchOS
APP_ENV=development
DATA_MODE=demo
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://researchos:researchos_dev@postgres:5432/researchos
DATABASE_URL_SYNC=postgresql://researchos:researchos_dev@postgres:5432/researchos
POSTGRES_USER=researchos
POSTGRES_PASSWORD=researchos_dev
POSTGRES_DB=researchos

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO / S3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=researchos-documents
S3_REGION=us-east-1

# AI Provider (not required for demo mode)
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-004

# Auth
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
DEMO_USER_EMAIL=demo@researchos.dev
DEMO_USER_PASSWORD=demo123456

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ResearchOS

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=30

# Cors
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
